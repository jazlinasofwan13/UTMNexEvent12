<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/organizer_blue_primary" />
        </shape>
    </item>

    <!-- Batik Pattern (High visibility as per user request) -->
    <item>
        <bitmap
            android:src="@drawable/organizer_bg_header_pattern"
            android:tileMode="repeat"
            android:alpha="0.8" />
    </item>

    <!-- Gradient for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#60000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>